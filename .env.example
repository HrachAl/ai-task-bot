# --- PostgreSQL ---
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=taskbot
POSTGRES_DB=taskbot
DATABASE_URL=postgresql+asyncpg://taskbot:taskbot@postgres:5432/taskbot

# --- App ---
APP_NAME=AI Task Bot
DEBUG=false
LOG_LEVEL=INFO
# Only used when the frontend dev server runs outside nginx; in production
# nginx proxies /api and /ws same-origin, so no CORS is involved.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis ---
# Celery broker + result backend.
REDIS_URL=redis://redis:6379/0
# Realtime event bus: a separate logical DB on the same instance.
REDIS_PUBSUB_URL=redis://redis:6379/1
TASK_EVENTS_CHANNEL=task_events

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
MAX_VOICE_DURATION_SECONDS=120
MAX_VOICE_FILE_MB=20

# --- OpenAI / Whisper ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=

# --- Bot -> backend ---
BACKEND_INTERNAL_URL=http://backend:8000

# Shared secret that lets the bot act on behalf of any Telegram user.
#
# CHANGE THIS BEFORE DEPLOYING. The value below is a placeholder for local
# development only. Anywhere /api is reachable from the internet, whoever
# knows this string can read and modify any user's board:
#
#   openssl rand -hex 24
#
INTERNAL_API_TOKEN=local-dev-only-change-me

# --- Dashboard ---
# Public URL of the dashboard; the bot builds each user's /dashboard link
# from it.
DASHBOARD_BASE_URL=http://localhost:3001
