# --- PostgreSQL ---
# Used both to initialize the postgres container and to build DATABASE_URL
# below (docker-compose.yml overrides DATABASE_URL's host:port to
# postgres:5432 automatically — only the credentials here need to match).
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=taskbot
POSTGRES_DB=taskbot

# Full async SQLAlchemy URL used by the FastAPI app and Alembic.
DATABASE_URL=postgresql+asyncpg://taskbot:taskbot@postgres:5432/taskbot

# --- App ---
APP_NAME=AI Task Bot
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (the React dashboard).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- Redis pub/sub (realtime task events -> WebSocket clients) ---
REDIS_PUBSUB_URL=redis://redis:6379/1
TASK_EVENTS_CHANNEL=task_events

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
MAX_VOICE_DURATION_SECONDS=120
MAX_VOICE_FILE_MB=20

# --- OpenAI / Whisper ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=

# --- Bot -> backend integration ---
BACKEND_INTERNAL_URL=http://backend:8000

# Shared secret the bot uses to call the API on behalf of a Telegram user.
# Bot and backend both read this value; the default works as-is on the
# private Docker network, where the API is not reachable from outside.
INTERNAL_API_TOKEN=internal-dev-token

# --- Dashboard ---
# Public URL of the React dashboard. The bot builds each user's personal
# login link from it, so set this to whatever address people actually open
# (e.g. https://your-domain.example).
DASHBOARD_BASE_URL=http://localhost:3001
